{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "$env{HOME}/build/XrTopoR-${presetName}",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/gcc-16/bin/gcc",
        "CMAKE_CXX_COMPILER": "/opt/gcc-16/bin/g++",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-rpath,/opt/gcc-16/lib64 -Wl,-rpath,/opt/gcc-16/lib",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,-rpath,/opt/gcc-16/lib64 -Wl,-rpath,/opt/gcc-16/lib"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "jobs": 16 },
    { "name": "release", "configurePreset": "release", "jobs": 16 }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
