#pragma once
// Generated by cmake/Version.cmake at every build: the version of XrTopoR and where the build came from.

#define XR_VERSION "@VERSION@"            // the project's (CMakeLists.txt)
#define XR_VERSION_FULL "@full@"          // as shown: the tag's, or the project's with the commit
#define XR_GIT_REF "@ref@"                // the branch or tag built
#define XR_GIT_SHA "@sha@"                // the commit built
#define XR_GIT_DESCRIBE "@describe@"      // git describe --tags --always --dirty
#define XR_BUILD_DATE "@BUILD_DATE@"      // when the build was configured
#define XR_REPOSITORY "https://github.com/XRay3D/XrTopoR"

#if defined(__MINGW32__)
#define XR_COMPILER "GCC " __VERSION__ ", MinGW-w64 " __MINGW64_VERSION_STR
#elif defined(__clang__)
#define XR_COMPILER "Clang " __clang_version__
#elif defined(__GNUC__)
#define XR_COMPILER "GCC " __VERSION__
#else
#define XR_COMPILER "unknown compiler"
#endif
